{
  "name": "x1-basketball",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "vars": { "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173" },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    }
  ],
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
